# ============================================================================
# Sinergia Digital - .htaccess para Apache (Hostinger, cPanel, etc.)
# Cabeceras de seguridad que el navegador SOLO respeta si vienen del servidor.
# Reemplaza www.sinergia.digital por tu dominio real.
# ============================================================================

# ---------- 1. HTTPS obligatorio ----------
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Redirige todo a HTTPS
  RewriteCond %{HTTPS} !=on
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

  # Fuerza el dominio CON www, que es el que declaran el canonical, el
  # og:url y el sitemap. Si prefieres el dominio sin www, cambia las tres
  # referencias (canonical, og:url, sitemap.xml) Y este bloque a la vez.
  RewriteCond %{HTTP_HOST} !^www\. [NC]
  RewriteRule ^(.*)$ https://www.%{HTTP_HOST}/$1 [R=301,L]

  # URLs limpias: cualquier ruta que no sea un archivo o carpeta real
  # se sirve con index.html (la app usa History API).
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} !^/(robots\.txt|sitemap\.xml)$
  RewriteRule ^ index.html [L]
</IfModule>

# ---------- 2. Cabeceras de seguridad ----------
<IfModule mod_headers.c>
  # HSTS: fuerza HTTPS en el navegador durante 1 ano. Sube preload solo cuando
  # estes seguro de que TODO el sitio (incluidos subdominios) va por HTTPS.
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

  # Evita que el sitio se cargue dentro de un iframe (clickjacking).
  # En <meta> el navegador IGNORA esto: tiene que ir como cabecera.
  Header always set X-Frame-Options "DENY"

  # Evita que el navegador "adivine" el tipo de contenido.
  Header always set X-Content-Type-Options "nosniff"

  # No filtrar la URL completa a otros origenes.
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Desactiva APIs del navegador que no usamos.
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=(), magnetometer=(), gyroscope=(), fullscreen=(self)"

  # Aislamiento de origen cruzado (mitiga Spectre y fugas de datos).
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Cross-Origin-Resource-Policy "same-origin"

  # CSP como cabecera. Aqui SI se puede usar frame-ancestors (en <meta> no).
  # 'unsafe-inline' es necesario porque el CSS y el JS van embebidos en index.html.
  # Para quitarlo: separa CSS/JS a archivos y usa nonce o hash.
  Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; frame-src https://www.bc.gob.cu; script-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data:; connect-src 'self'; form-action 'self'; manifest-src 'self'; upgrade-insecure-requests"

  # Quita la cabecera que revela la version del servidor
  Header unset X-Powered-By
  Header unset Server
</IfModule>

# ---------- 3. Compresion ----------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE application/xml image/svg+xml
</IfModule>

# ---------- 4. Cache ----------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType application/xml "access plus 1 day"
</IfModule>

# ---------- 5. Bloquea archivos que no deben servirse ----------
<FilesMatch "^\.(env|git|htaccess|htpasswd|DS_Store)">
  Require all denied
</FilesMatch>
<FilesMatch "\.(md|log|bak|sql|ini|conf)$">
  Require all denied
</FilesMatch>

# ---------- 6. Pagina de error ----------
ErrorDocument 404 /index.html

# ---------- 7. Tipos MIME ----------
<IfModule mod_mime.c>
  AddType image/svg+xml .svg
  AddType application/manifest+json .webmanifest
</IfModule>
